# Copie este archivo como secrets.toml (local) o pegue su contenido en
# Settings -> Secrets de Streamlit Cloud. NO commitear secrets.toml.

# Proyecto de Google Cloud habilitado para Earth Engine
ee_project = "mi-proyecto-ee"

# Solo para despliegue (Streamlit Cloud): service account de GEE.
# Local NO es necesario si ya corrió `earthengine authenticate`.
[gee_service_account]
type = "service_account"
project_id = "mi-proyecto-ee"
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "sat-pajarito@mi-proyecto-ee.iam.gserviceaccount.com"
client_id = "..."
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "..."
